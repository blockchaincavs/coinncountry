---
// All stories, newest first.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { loadSiteData } from '../../site-data';
import { withAds } from '../../core/stories';

const { site, stories, topics } = await loadSiteData();
---
<BaseLayout site={site} topics={topics} title="All stories" description={`Every ${site.name} story: fact-checked American and economic history, newest first.`}>
  <header class="page-head">
    <span class="label label--red">{stories.length} {stories.length === 1 ? 'story' : 'stories'}</span>
    <h1>All stories</h1>
    <p>{site.tagline}</p>
  </header>
  <div class="story-list">
    {withAds(stories).map((x) =>
      x.kind === 'item' ? <StoryCard story={x.item} headingLevel={2} /> : <AdSlot site={site} size="leaderboard" label={`Ad slot · 728×90 between stories (#${x.n})`} />
    )}
  </div>
  <AdSlot site={site} size="billboard" />
</BaseLayout>
