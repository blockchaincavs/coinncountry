---
// A 9:16 Short cover that links to the full story (or to the Short on YouTube once it has an ID).
const { short, story } = Astro.props;
const href = `/stories/${story.slug}`;
---
<a class="short-card" href={href}>
  <img class="short-card__img" src={short.cover} alt={`Short cover: ${short.title}`} width="540" height="960" loading="lazy" />
  <span class="short-card__title">{short.title}</span>
  <span class="short-card__more">Read the whole story →</span>
</a>
