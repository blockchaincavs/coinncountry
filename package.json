{
  "name": "coinncountry-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "check-stories": "tsx scripts/check-stories.ts",
    "tests": "jest --silent --coverage --coverageReporters=text-summary",
    "typecheck": "astro check --minimumSeverity warning",
    "lint": "eslint . --quiet",
    "format": "prettier --write . --log-level warn"
  },
  "dependencies": {
    "@astrojs/node": "11.1.14",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "9.39.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
